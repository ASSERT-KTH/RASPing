Bootstrap: docker
From: python:3.13.1-bookworm

# Build:  apptainer build container.sif container.def   (from the repository root)
# The repository itself is bind-mounted at run time (see rasping/cluster.py), so the
# image only holds the locked dependencies; rebuild it when uv.lock changes.

%files
    ./pyproject.toml /opt/rasping/pyproject.toml
    ./uv.lock /opt/rasping/uv.lock
    ./raspbugs/operators /opt/rasping/raspbugs/operators

%environment
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export PATH=/opt/venv/bin:$PATH

%post
    # Debian bookworm: bullseye's security repository no longer serves the pinned packages.
    # No TeX Live: nothing renders LaTeX (figures are made locally from results/).
    apt-get update -y
    apt-get install -y --no-install-recommends patch
    rm -rf /var/lib/apt/lists/*
    pip3 install uv==0.13.9
    cd /opt/rasping
    UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --locked --extra cuda --no-install-project
